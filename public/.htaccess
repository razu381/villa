# Vila Leku: the static site (Next.js export, out/). Apache behind nginx and
# Cloudflare on the cPanel host. HTTPS and www → the bare domain are Cloudflare's.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/avif .avif
AddType image/webp .webp
AddType video/webm .webm
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The classic site is the home now.
  RewriteRule ^classic/?$ / [R=301,L]
  # The old WordPress site.
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php|feed|ralta)(/.*)?$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # The 3D is a direct link only: never indexed (its page says so too).
  <If "%{REQUEST_URI} =~ m#^/3d-immersive#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  # Pages are checked on every visit, so a new deploy shows at once (their
  # build files are replaced with it); the build files themselves never change.
  <If "%{REQUEST_URI} =~ m#(/|\.html)$#">
    Header set Cache-Control "no-cache"
  </If>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(media|_img)/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
